# Required
OPENROUTER_API_KEY=sk-or-...

# Optional: any model slug listed on https://openrouter.ai/models
TRIAGE_MODEL=anthropic/claude-sonnet-4.5
TRIAGE_FAST_MODEL=anthropic/claude-haiku-4.5
TRIAGE_MAX_REVISIONS=3
TRIAGE_TEMPERATURE=0
TRIAGE_REQUEST_TIMEOUT=60

# Optional: needed to fetch issues from or post comments to GitHub
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/name
