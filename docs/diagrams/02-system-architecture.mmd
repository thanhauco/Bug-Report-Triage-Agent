%% Runtime components and external systems. Dashed edges depend on CLI flags.
flowchart LR
    subgraph entry ["Entry points"]
        API[["Python API
        build_graph()"]]:::term
        CLI[["triage-agent CLI
        cli.py"]]:::term
    end

    subgraph core ["Orchestration · triage_agent"]
        G{{"Compiled StateGraph
        graph.py + routing.py"}}:::decision
        CP[("Checkpointer
        InMemorySaver")]:::store
        N["TriageNodes
        nodes.py"]:::tool
        P("Prompts and templates
        prompts.py · comments.py"):::llm
    end

    subgraph tools ["Tools · injected via Dependencies"]
        CS["FilesystemCodeSearcher"]:::tool
        DF["LexicalDuplicateFinder"]:::tool
        PO["ConsolePoster or
        GitHubPoster"]:::tool
        GHC["GitHubClient"]:::tool
    end

    subgraph ext ["External systems and data"]
        OR[("OpenRouter API
        main + fast model")]:::external
        SRC[("Local source tree")]:::store
        KI[("known_issues.json")]:::store
        GH[("GitHub REST API")]:::external
    end

    API -- "invoke / resume" --> G
    CLI -- "invoke / resume" --> G
    G <-- "state per thread_id" --> CP
    G -- runs --> N
    N -- "builds messages" --> P
    P -- "messages via ChatOpenAI" --> OR
    N --> CS
    N --> DF
    N --> PO
    CS -. "--code-root" .-> SRC
    DF -. "corpus: --known-issues" .-> KI
    DF -. "corpus: --repo" .-> GHC
    PO -. "--post" .-> GHC
    CLI -. "fetch issue: --issue N" .-> GHC
    GHC --> GH

    classDef llm fill:#4D7FEE,stroke:#2B5BC9,stroke-width:1.5px,color:#0B1530
    classDef tool fill:#69D0BF,stroke:#2F8F7E,stroke-width:1.5px,color:#0B2A25
    classDef ok fill:#69D0BF,stroke:#1F6E61,stroke-width:3px,color:#0B2A25
    classDef decision fill:#EC8131,stroke:#B85E1C,stroke-width:1.5px,color:#2A1405
    classDef gate fill:#EC8131,stroke:#8A4512,stroke-width:3px,color:#2A1405
    classDef term fill:#F3EFE6,stroke:#9C9585,stroke-width:1.5px,color:#1F2328
    classDef store fill:#F3EFE6,stroke:#4D7FEE,stroke-width:2px,color:#1F2328
    classDef external fill:#E94E5E,stroke:#B3303E,stroke-width:1.5px,color:#2A0508
    classDef reject fill:#FFFFFF,stroke:#E94E5E,stroke-width:2px,stroke-dasharray:5 4,color:#B3303E
    style entry fill:#FBFAF6,stroke:#C9C2B2
    style core fill:#FEF5EE,stroke:#EC8131
    style tools fill:#F2FBF9,stroke:#2F8F7E
    style ext fill:#FDF1F2,stroke:#E94E5E
